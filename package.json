{
  "name": "omniroute-agent-extension",
  "version": "3.2.2",
  "description": "OmniRoute extension for Pi Coding Agent, OMP, and Prime Agent with model sync, pricing, telemetry, catalog autosync, and OpenAI-compatible routing",
  "keywords": [
    "omp-plugin",
    "oh-my-pi",
    "prime-agent",
    "prime-agent-extension",
    "pi-package",
    "pi-coding-agent",
    "omniroute",
    "omniroute-extension",
    "openai-compatible",
    "model-router",
    "ai-gateway",
    "ai-agent-extension",
    "llm",
    "extension"
  ],
  "type": "module",
  "files": [
    "shared.ts",
    "telemetry.ts",
    "omp.ts",
    "pi.ts",
    "prime.ts",
    "scripts/sync-once.ts",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./omp.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./pi.ts",
      "./prime.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "smoke": "node --experimental-strip-types -e \"import('./omp.ts').then(()=>console.log('omp ok')).catch(e=>{console.error(e);process.exit(1)})\" && node --experimental-strip-types -e \"import('./pi.ts').then(()=>console.log('pi ok')).catch(e=>{console.error(e);process.exit(1)})\" && node --experimental-strip-types -e \"import('./prime.ts').then(()=>console.log('prime ok')).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "author": "md-riaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-riaz/omniroute-agent-extension.git"
  },
  "homepage": "https://github.com/md-riaz/omniroute-agent-extension#readme",
  "bugs": {
    "url": "https://github.com/md-riaz/omniroute-agent-extension/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.60.0",
    "@oh-my-pi/pi-coding-agent": ">=15.9.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^15.8.3",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
